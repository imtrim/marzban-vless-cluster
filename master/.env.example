UVICORN_HOST=127.0.0.1
UVICORN_PORT=2053
UVICORN_SSL_CERTFILE=/var/lib/marzban/certs/panel.crt
UVICORN_SSL_KEYFILE=/var/lib/marzban/certs/panel.key
UVICORN_SSL_CA_TYPE=private
SUDO_USERNAME=admin
SUDO_PASSWORD=change-me
SQLALCHEMY_DATABASE_URL=sqlite:////var/lib/marzban/db.sqlite3
XRAY_JSON=/var/lib/marzban/xray_config.json
XRAY_SUBSCRIPTION_URL_PREFIX=https://<master_domain>

# cluster addresses (real values only in master/.env)
MASTER_IP=<ip_master>
MASTER_DOMAIN=<master_domain>
# extra SNI names served by the same Caddy on master, space separated
MASTER_EXTRA_DOMAINS=
SLAVE_IP=<ip_slave>
SLAVE_DOMAIN=<slave_domain>
MARZBAN_DATA=/var/lib/marzban

# Generated by scripts/setup-secrets.sh — do not commit
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=

# slave (SLAVE_DOMAIN) inbound — generate: docker exec marzban xray x25519; openssl rand -hex 8
NODE2_REALITY_PRIVATE_KEY=
NODE2_REALITY_PUBLIC_KEY=
NODE2_REALITY_SHORT_ID=
